# Salin menjadi .env.production dan jangan commit file tersebut.
# Gunakan password URL-safe yang panjang agar DATABASE_URL tidak perlu encoding tambahan.
POSTGRES_DB=emisell_finance
POSTGRES_USER=emisell
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_MINIMAL_32_KARAKTER
DATABASE_URL=postgresql://emisell:GANTI_DENGAN_PASSWORD_ACAK_MINIMAL_32_KARAKTER@postgres:5432/emisell_finance

# Wajib berupa URL HTTPS final tanpa slash di belakang.
APP_ORIGIN=https://finance.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TRUST_PROXY=1
TZ=Asia/Jakarta

# Opsional: gunakan alamat registry jika image dibangun oleh CI/CD.
APP_IMAGE=emisell-finance:latest
POSTGRES_VOLUME_NAME=emisell_finance_postgres_data
